# 이 파일을 .env 로 복사해서 채운다. .env는 커밋되지 않는다.
# 서버에서는 GitHub Actions가 배포할 때마다 /home/ubuntu/coach2/.env 를 덮어쓴다.

DB_USERNAME=coach2

# 필수. 비워두면 컨테이너가 의도적으로 기동하지 않는다(기본 비밀번호로 뜨는 사고 방지).
# eastAI의 DB_PASSWORD를 재사용하지 말 것 — 별개 DB이므로 별개 비밀번호를 쓴다.
DB_PASSWORD=

# 관리자 API(/api/admin/**) 헤더 시크릿. 필수 — 비우면 기동하지 않는다.
# 요청 시: X-Admin-Secret: <이 값>
# 생성 예: openssl rand -hex 32
ADMIN_SECRET=

# nginx가 붙이는 경로 prefix.
# 전용 호스트 + 서브도메인으로 옮기면 이 값을 '빈 값'으로 둔다 (CONTEXT_PATH= 한 줄).
# compose가 ${CONTEXT_PATH-/reserve} 로 콜론 없이 받으므로 빈 값이 그대로 전달된다 —
# 절차는 deploy/README.md 의 'eastAI와 인스턴스 분리' 절.
CONTEXT_PATH=/reserve
